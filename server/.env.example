PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=smartrecruit_super_secret_jwt_key_2026

# MongoDB Connection String (MongoDB Atlas hoặc Local MongoDB)
# Ví dụ: mongodb+srv://username:password@cluster0.mongodb.net/tuvan_cv?retryWrites=true&w=majority
# Hoặc Local: mongodb://127.0.0.1:27017/tuvan_cv
MONGODB_URI=mongodb://127.0.0.1:27017/tuvan_cv

# Cấu hình Email SMTP (Nodemailer - Dùng Gmail App Password hoặc SMTP Server)
# Nếu để trống, hệ thống sẽ tự động in mã OTP ra Terminal/Console để tiện test
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="SmartRecruit AI" <noreply@smartrecruit.vn>
